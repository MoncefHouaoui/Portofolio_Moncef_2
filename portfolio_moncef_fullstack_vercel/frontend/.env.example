# En local, tu peux laisser cette variable vide parce que Vite utilise le proxy vers le backend.
# Pour Vercel, ne mets pas localhost : les appels API doivent rester relatifs avec /api.
# VITE_API_URL=

# Identifiants de connexion utilisés en fallback si le backend est inaccessible.
# Doit correspondre aux valeurs définies dans backend/.env
VITE_VALID_EMAIL=ton-email-admin@example.fr
VITE_VALID_PASSWORD=ton-mot-de-passe-admin
VITE_AUTH_TOKEN=un-token-secret-long-et-aleatoire
